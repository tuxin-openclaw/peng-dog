{
  "name": "peng-dog",
  "version": "0.1.0",
  "private": true,
  "description": "Peng-Dog 小狗键鼠同步互动桌宠（Web + Tauri 双端共享）",
  "scripts": {
    "dev:web": "node scripts/dev-server.mjs",
    "build:web": "node scripts/build-web.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:win": "PATH=\"$HOME/.cargo/bin:/opt/homebrew/opt/llvm/bin:$PATH\" tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
